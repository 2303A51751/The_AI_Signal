// prisma/schema.prisma
// Architectural note: We use JSONB columns for maximum flexibility with dynamic configs.
// All user data is scoped by userId for multi-tenancy without schema migrations per user.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appConfigs    AppConfiguration[]
  dynamicData   DynamicData[]
  workflowLogs  WorkflowLog[]

  @@map("users")
}

// ─────────────────────────────────────────────
// APP CONFIGURATION
// Stores the full metadata JSON that drives the runtime.
// `schema` is the validated+repaired JSON config blob.
// `rawSchema` is the original user-submitted blob (for export/diff).
// ─────────────────────────────────────────────
model AppConfiguration {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String   // URL-safe identifier, e.g. "crm-app"
  description String?
  version     Int      @default(1)

  // The validated and auto-repaired JSON config
  schema      Json
  // The original raw submission - never mutated, used for export
  rawSchema   Json?

  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dynamicData  DynamicData[]
  workflowLogs WorkflowLog[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("app_configurations")
}

// ─────────────────────────────────────────────
// DYNAMIC DATA
// Generic entity store keyed by (appId, entity, recordId).
// `data` holds the actual record as JSONB.
// This avoids needing per-app migrations - one table, infinite apps.
// Tradeoff: No DB-level column constraints; enforced at API layer via Zod.
// ─────────────────────────────────────────────
model DynamicData {
  id       String   @id @default(cuid())
  userId   String
  appId    String
  entity   String   // e.g. "employees", "products", "orders"
  data     Json     // The actual record payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  app  AppConfiguration @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, entity])
  @@index([userId])
  @@map("dynamic_data")
}

// ─────────────────────────────────────────────
// WORKFLOW LOG
// Stores workflow trigger/action execution records.
// ─────────────────────────────────────────────
model WorkflowLog {
  id          String   @id @default(cuid())
  userId      String
  appId       String
  trigger     String   // e.g. "form_submit", "record_create"
  entity      String?
  payload     Json?
  actions     Json?    // Array of actions taken
  status      String   @default("success") // success | failed | skipped
  createdAt   DateTime @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  app  AppConfiguration @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@map("workflow_logs")
}
