# .env.example
# Copy to .env.local and fill in your values

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL via Neon, Railway, or Supabase)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/metaruntime?sslmode=require"

# ─────────────────────────────────────────────
# NEXT.JS
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─────────────────────────────────────────────
# AUTH (replace with NextAuth / Clerk secret when integrating real auth)
# ─────────────────────────────────────────────
# NEXTAUTH_SECRET="your-secret-here"
# NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# OPTIONAL: GitHub Gist export (OAuth token with gist scope)
# ─────────────────────────────────────────────
# GITHUB_TOKEN="ghp_..."
